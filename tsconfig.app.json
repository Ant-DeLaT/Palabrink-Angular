/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    
    // Problema rutas
    // https://github.com/microsoft/TypeScript/issues/62508
    // Posible solución
    // https://github.com/andrewbranch/ts5to6

    //He ejecutado 
    /*
      npx @andrewbranch/ts5to6 --fixBaseUrl ./tsconfig.app.json
      npx @andrewbranch/ts5to6 --fixRootDir ./tsconfig.app.json
    */
    //tsconfig ya no devuelve errores
    "outDir": "src/app",
    "types": [
      "node"
    ],
    "rootDir": "./src"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}
